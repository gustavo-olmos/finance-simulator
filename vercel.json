{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/simulae-financiamento/browser",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/simulae-financiamento/**",
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
