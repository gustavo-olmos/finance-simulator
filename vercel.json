{
  "buildCommand": "npm run build",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/simulae-financiamento/**",
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/og",  "destination": "/api/og" },
    { "source": "/(.*)",    "destination": "/api/index" }
  ]
}
